[Unit]
Description=CyberForge Server Edition Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cyberforge-server
Group=cyberforge-server
WorkingDirectory=/opt/cyberforge-server/current
EnvironmentFile=-/etc/cyberforge-server/server.env
Environment=CF_SERVER_DATA_DIR=/var/lib/cyberforge-server
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/cyberforge-server/current/.venv/bin/python /opt/cyberforge-server/current/server.py serve --bind 127.0.0.1 --port 8787 --data-dir /var/lib/cyberforge-server
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/cyberforge-server

[Install]
WantedBy=multi-user.target
